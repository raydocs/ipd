[Unit]
Description=ipd IP intelligence
After=network-online.target
Wants=network-online.target
# Start inside the slice. Do not enable this unit until the operator approves
# a real host. See DEPLOY.md.

[Service]
Type=simple
User=ipd
Group=ipd
Slice=ipd.slice
ExecStart=/usr/local/bin/ipd serve
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ipd
Environment=IPD_DOMAIN=localhost
Environment=IPD_HTTP_ADDR=127.0.0.1:8787
Environment=IPD_DNS_ADDR=127.0.0.1:5353
Environment=IPD_STUN_ADDR=127.0.0.1:34780
Environment=IPD_TLS_ADDR=127.0.0.1:8443
Environment=IPD_DATA_DIR=/var/lib/ipd
Environment=IPD_SHARE_ENABLED=false
Environment=IPD_LABELS_ENABLED=false

[Install]
WantedBy=multi-user.target
